# OpenAI-kompatibler Endpunkt. Der Key bleibt serverseitig im BFF.
KICONNECT_BASE_URL=https://chat.kiconnect.nrw/api/v1
KICONNECT_API_KEY=

# Modell mit verifiziertem Tool-Calling. Alternativen: gpt-5.4-mini, qwen-qwen3-8-27b
OKG_MODEL=openai-gpt-oss-120b

# Obergrenzen des Agenten (F7: harter Deckel). Gemessen: eine DBpedia-Rangliste
# braucht kalt bis 16 s, eine teure Wikidata-Abfrage bis 12 s.
OKG_MAX_ROUNDS=4
OKG_BUDGET_MS=26000

# Zusatzfrist fuer die Schlussantwort nach erschoepftem Werkzeugbudget
OKG_FINAL_ANSWER_MS=15000

PORT=8787

# Nur setzen, wenn der BFF hinter einem eigenen Reverse Proxy laeuft
# TRUST_PROXY=1
